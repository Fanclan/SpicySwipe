{
  "name": "spicyswipe",
  "version": "3.0.2",
  "private": true,
  "description": "One desktop workspace for Tinder, Android dating apps, and your AI",
  "scripts": {
    "dev": "node scripts/serve.js",
    "serve": "node scripts/serve.js",
    "test": "node --test tests/*.test.js",
    "lint": "node scripts/check.js",
    "check": "node scripts/check.js",
    "build": "node scripts/build.js",
    "desktop:build": "node scripts/desktop-build.cjs",
    "desktop": "npm run desktop:build && electron .",
    "desktop:pack": "npm run desktop:build && electron-builder --dir",
    "desktop:mac": "npm run desktop:build && electron-builder --mac --arm64 --publish never",
    "desktop:win": "npm run desktop:build && electron-builder --win --x64 --publish never",
    "desktop:linux": "npm run desktop:build && electron-builder --linux --x64 --publish never",
    "desktop:mac:x64": "npm run desktop:build && electron-builder --mac --x64 --publish never"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "author": "Soufienne Rahali",
  "license": "SEE LICENSE IN License",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3"
  },
  "main": "desktop/main.cjs",
  "homepage": "https://github.com/Fanclan/SpicySwipe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fanclan/SpicySwipe.git"
  },
  "bugs": {
    "url": "https://github.com/Fanclan/SpicySwipe/issues"
  },
  "contributors": [
    {
      "name": "Fanclan",
      "url": "https://fanclan.io"
    }
  ]
}
